JWT_SECRET=troque-por-um-valor-aleatorio-seguro
ENCRYPTION_KEY=troque-por-outra-chave-aleatoria-segura

# Desligado por padrao. So ative se entender o risco: da ao backend acesso ao Docker do host
# (root-equivalente) pra ele rodar `docker compose pull/up` sozinho no botao "Atualizar agora"
# (Configuracoes > Atualizacoes). Ver README, secao "Atualizacoes".
ENABLE_AUTO_UPDATE=false

# Desligado por padrao. So ative se o backend roda atras de um reverse proxy proprio (nginx,
# Caddy, Traefik) que sempre define X-Forwarded-Proto -- necessario pra "Forcar HTTPS"
# (Configuracoes > Geral) funcionar sem entrar em loop de redirect. NUNCA ativar se o backend
# estiver exposto direto na internet sem proxy na frente.
TRUST_PROXY_HEADERS=false

# Tempo maximo de uma sessao, em horas, desde o login. A sessao se renova sozinha enquanto a
# tela estiver aberta (Modo TV, abas paradas), mas depois desse limite pede login de novo.
# Padrao 168 (7 dias). 0 desliga o limite -- uma sessao roubada nunca mais expiraria enquanto
# alguem a mantivesse aberta.
SESSION_MAX_HOURS=168
